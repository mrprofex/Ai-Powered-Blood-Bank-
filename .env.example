# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database — Neon PostgreSQL & Prisma (Phase 2+ Configuration)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Authentication — Google OAuth & Sessions (Phase 2+ Configuration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# AI Prediction Narrative — Server-Side Only (Phase 5+ Configuration)
GEMINI_API_KEY=

# External Data Integration — Authorized e-RaktKosh API (Phase 3+ Configuration)
ERAKTKOSH_API_BASE_URL=
ERAKTKOSH_API_KEY=

# Google Maps JS API (Client-Side Public Map Display Key — Restrict by HTTP Referrer)
VITE_GOOGLE_MAPS_API_KEY=

# Rate Limiting — All Thresholds Configurable (Phase 1+ Configuration)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_ADMIN_MAX=100
